# ==========================================================
# Zero 1 Barbearia — .env de TESTE/HOMOLOGAÇÃO na Hostinger
# Preencha APP_URL e as 3 linhas DB_* (hPanel > Bancos de dados MySQL).
# Este arquivo fica em domains/SEU_DOMINIO/zero1/.env (FORA de public_html).
# ==========================================================
APP_NAME="Zero 1 Barbearia"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://SEU_DOMINIO_AQUI

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
BUSINESS_TIMEZONE=America/Sao_Paulo

# Teste: selo de demonstração + dados [DEMO]. Na versão real: false.
ZERO1_DEMO_MODE=true

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_zero1
DB_USERNAME=u000000000_zero1
DB_PASSWORD=COLOQUE_A_SENHA_DO_BANCO

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
# Uploads direto em public_html/storage (sem precisar de symlink/SSH)
PUBLIC_DISK_IN_PUBLIC=true
MEDIA_MAX_UPLOAD_KB=6144

QUEUE_CONNECTION=database
CACHE_STORE=database

SECURITY_CSP=true
SECURITY_HSTS=false

# Pagamentos SIMULADOS (nenhuma cobrança real) — liberado só para teste.
PAYMENT_GATEWAY=simulated
ALLOW_SIMULATED_PAYMENTS=true
SIMULATED_CARD_RENEWAL=approved

# E-mails vão para o log no teste. Para enviar de verdade, troque para smtp e preencha:
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="nao-responda@SEU_DOMINIO_AQUI"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
