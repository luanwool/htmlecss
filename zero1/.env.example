# ==========================================================
# Zero 1 Barbearia — variáveis de ambiente
# NUNCA versione o .env real. Em produção, mantenha-o FORA de public_html.
# ==========================================================
APP_NAME="Zero 1 Barbearia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
BUSINESS_TIMEZONE=America/Sao_Paulo

# Exibe selo de demonstração e permite o DemoSeeder (nunca em produção)
ZERO1_DEMO_MODE=false

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# MySQL/MariaDB (Hostinger: hPanel > Bancos de dados MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zero1
DB_USERNAME=zero1
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
MEDIA_MAX_UPLOAD_KB=6144

# Fila em banco, processada pelo cron (schedule:run) — sem worker permanente.
QUEUE_CONNECTION=database
CACHE_STORE=database

# Segurança
SECURITY_CSP=true
SECURITY_HSTS=true

# E-mail (Hostinger: smtp.hostinger.com, porta 465, SSL)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="nao-responda@seu-dominio.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Pagamentos. Nesta versão só existe o gateway SIMULADO (nenhum dinheiro real circula).
# O simulador é bloqueado em produção, salvo ALLOW_SIMULATED_PAYMENTS=true (homologação).
PAYMENT_GATEWAY=simulated
ALLOW_SIMULATED_PAYMENTS=false
PAYMENT_WEBHOOK_SECRET=
SIMULATED_CARD_RENEWAL=approved

# Mercado Pago (próxima fase) — use credenciais de TESTE fora de produção.
MERCADOPAGO_ENV=sandbox
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
